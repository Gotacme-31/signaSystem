generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  COUNTER
  MULTI_COUNTER
  PAYMENTS
  PRODUCTION
}

enum OrderStage {
  REGISTERED
  IN_PROGRESS
  READY
  DELIVERED
}

enum ShippingType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum PaymentVerificationStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  REJECTED
}

enum UnitType {
  METER
  PIECE
}

enum StepStatus {
  PENDING
  DONE
}

enum ShippingStage {
  SHIPPED
  RECEIVED
}

enum ParamChargeType {
  PER_METER
  PER_PIECE
}

enum OrderFileStatus {
  ACTIVE
  PENDING_DELETE
  DELETED
  DELETE_FAILED
}

enum OrderFileType {
  ORIGINAL
  PREPARED
  OTHER
}

enum ProductionBatchStatus {
  OPEN
  FULL
  CLOSED
  COMPLETED
  CANCELLED
}

enum ProductionScheduleStatus {
  NOT_REQUIRED
  AUTO_SCHEDULED
  AUTO_OVERFLOW_ESTIMATED
  MANUAL_REQUIRED
  MANUAL_SET
  FAILED
}

enum ProductionScheduleSource {
  NONE
  AUTO
  MANUAL
}

enum ProductionTargetWindow {
  NEXT_AVAILABLE
  FIRST_OF_DAY
  LAST_OF_DAY
}

enum ProductionBatchItemStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users                   User[]
  userAccesses            UserBranchAccess[]
  orders                  Order[]
  pickupOrders            Order[]                   @relation("PickupBranch")
  branchProducts          BranchProduct[]
  productionConfigs       ProductProductionConfig[]
  productionBatches       ProductionBatch[]
  productionBlackoutDates ProductionBlackoutDate[]
}

model User {
  id             Int                @id @default(autoincrement())
  username       String             @unique
  name           String
  email          String?            @unique
  passwordHash   String
  role           UserRole           @default(STAFF)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  createdOrders  Order[]            @relation("OrderCreatedBy")
  branchId       Int?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  branchAccesses UserBranchAccess[]

  uploadedOrderFiles    OrderFile[]    @relation("OrderFileUploadedBy")
  downloadedOrderFiles  OrderFile[]    @relation("OrderFileDownloadedBy")
  verifiedOrderPayments OrderPayment[] @relation("OrderPaymentVerifiedBy")
}

model UserBranchAccess {
  id        Int      @id @default(autoincrement())
  userId    Int
  branchId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Customer {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String
  createdAt DateTime @default(now())

  orders Order[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  unitType     UnitType
  needsVariant Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  isCustomProductTemplate Boolean @default(false)

  minQty  Decimal @default(1) @db.Decimal(12, 3)
  qtyStep Decimal @default(1) @db.Decimal(12, 3)

  halfStepSpecialPrice Decimal? @db.Decimal(12, 2)

  branchProducts BranchProduct[]
  orderItems     OrderItem[]
  processSteps   ProductProcessStep[]

  variants     ProductVariant[]
  optionGroups ProductOptionGroup[]

  params                  ProductParam[]
  productionConfigs       ProductProductionConfig[]
  productionBatches       ProductionBatch[]
  productionBlackoutDates ProductionBlackoutDate[]

  @@index([isCustomProductTemplate])
}

model BranchProduct {
  id        Int     @id @default(autoincrement())
  branchId  Int
  productId Int
  isActive  Boolean @default(true)

  price     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  halfStepSpecialPrice Decimal? @db.Decimal(12, 2)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityPrices        BranchProductQuantityPrice[]
  variantPrices         BranchProductVariantPrice[]
  variantQuantityPrices BranchProductVariantQuantityPrice[]
  paramPrices           BranchProductParamPrice[]

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model BranchProductQuantityPrice {
  id              Int     @id @default(autoincrement())
  branchProductId Int
  minQty          Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  isActive        Boolean @default(true)
  order           Int     @default(0)

  branchProduct BranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)

  @@unique([branchProductId, minQty])
  @@index([branchProductId])
}

model BranchProductVariantPrice {
  id              Int     @id @default(autoincrement())
  branchProductId Int
  variantId       Int
  price           Decimal @db.Decimal(12, 2)
  isActive        Boolean @default(true)

  branchProduct BranchProduct  @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchProductId, variantId])
  @@index([branchProductId])
  @@index([variantId])
}

model BranchProductVariantQuantityPrice {
  id              Int     @id @default(autoincrement())
  branchProductId Int
  variantId       Int
  minQty          Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(12, 2)
  isActive        Boolean @default(true)
  order           Int     @default(0)

  branchProduct BranchProduct  @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchProductId, variantId, minQty])
  @@index([branchProductId])
  @@index([variantId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  order     Int     @default(0)
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchVariantPrices         BranchProductVariantPrice[]
  orderItems                  OrderItem[]
  branchVariantQuantityPrices BranchProductVariantQuantityPrice[]

  @@unique([productId, name])
  @@index([productId])
}

//
// ✅ NUEVO: catálogo de parámetros por producto (sin precio aquí)
//
model ProductParam {
  id         Int             @id @default(autoincrement())
  productId  Int
  name       String
  order      Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  chargeType ParamChargeType @default(PER_METER)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  branchParamPrices BranchProductParamPrice[]

  @@unique([productId, name])
  @@index([productId])
}

//
// ✅ NUEVO: precio de parámetro por sucursal (vía BranchProduct)
//
model BranchProductParamPrice {
  id              Int     @id @default(autoincrement())
  branchProductId Int
  paramId         Int
  priceDelta      Decimal @default(0) @db.Decimal(12, 2)
  isActive        Boolean @default(true)

  branchProduct BranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
  param         ProductParam  @relation(fields: [paramId], references: [id], onDelete: Cascade)

  @@unique([branchProductId, paramId])
  @@index([branchProductId])
  @@index([paramId])
}

model Order {
  id         Int @id @default(autoincrement())
  branchId   Int
  customerId Int
  createdBy  Int

  pickupBranchId Int
  pickupBranch   Branch @relation("PickupBranch", fields: [pickupBranchId], references: [id])

  stage         OrderStage     @default(REGISTERED)
  shippingType  ShippingType
  paymentMethod PaymentMethod
  shippingStage ShippingStage?

  deliveryDate DateTime
  deliveryTime String?

  autoEstimatedReadyAt      DateTime?
  manualReadyAt             DateTime?
  estimatedReadyAt          DateTime?
  productionScheduleStatus  ProductionScheduleStatus @default(NOT_REQUIRED)
  productionScheduleSource  ProductionScheduleSource @default(NONE)
  productionScheduleMessage String?

  notes String?

  // Total SIN IVA
  subtotalBeforeTax Decimal @default(0) @db.Decimal(12, 2)

  // Si el pedido lleva IVA
  hasIva Boolean @default(false)

  // IVA calculado
  ivaAmount Decimal @default(0) @db.Decimal(12, 2)

  // Total FINAL, con o sin IVA
  total Decimal @default(0) @db.Decimal(12, 2)

  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch               Branch                @relation(fields: [branchId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  creator              User                  @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items                OrderItem[]
  payments             OrderPayment[]
  files                OrderFile[]
  productionBatchItems ProductionBatchItem[]

  @@index([branchId, stage, deliveryDate])
  @@index([pickupBranchId, stage, deliveryDate])
  @@index([estimatedReadyAt])
  @@index([productionScheduleStatus])
  @@index([productionScheduleSource])
  @@index([customerId])
  @@index([createdBy])
}

model OrderPayment {
  id                 Int                       @id @default(autoincrement())
  orderId            Int
  method             PaymentMethod
  amount             Decimal                   @db.Decimal(12, 2)
  reference          String?
  verificationStatus PaymentVerificationStatus @default(NOT_REQUIRED)
  verifiedAt         DateTime?
  verifiedById       Int?
  verificationNotes  String?
  createdAt          DateTime                  @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("OrderPaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([method])
  @@index([verificationStatus])
  @@index([verifiedById])
  @@index([createdAt])
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  productNameSnapshot String
  unitTypeSnapshot    UnitType

  // Producto libre
  isCustomProduct   Boolean   @default(false)
  customProductName String?
  customUnitType    UnitType?
  customUnitPrice   Decimal?  @db.Decimal(12, 2)

  quantity Decimal @db.Decimal(12, 3)

  variant    Json?
  variantId  Int?
  variantRef ProductVariant? @relation(fields: [variantId], references: [id])

  appliedMinQty Decimal? @db.Decimal(12, 3)

  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  autoEstimatedReadyAt      DateTime?
  manualReadyAt             DateTime?
  estimatedReadyAt          DateTime?
  productionScheduleStatus  ProductionScheduleStatus @default(NOT_REQUIRED)
  productionScheduleSource  ProductionScheduleSource @default(NONE)
  productionScheduleMessage String?

  productionStep   String
  currentStepOrder Int             @default(1)
  isReady          Boolean         @default(false)
  steps            OrderItemStep[]

  options OrderItemOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id])
  files                OrderFile[]
  productionBatchItems ProductionBatchItem[]

  @@index([orderId])
  @@index([productId])
  @@index([estimatedReadyAt])
  @@index([productionScheduleStatus])
  @@index([productionScheduleSource])
  @@index([productionStep])
  @@index([variantId])
  @@index([isCustomProduct])
}

model ProductProductionConfig {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch        Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product       Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  windows       ProductionCapacityWindow[]
  quantityRules ProductionQuantityRule[]

  @@unique([branchId, productId])
  @@index([branchId])
  @@index([productId])
}

model ProductionCapacityWindow {
  id       Int @id @default(autoincrement())
  configId Int

  dayOfWeek   Int
  startsAt    String
  endsAt      String
  readyAt     String
  capacityQty Decimal @db.Decimal(12, 3)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config  ProductProductionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  batches ProductionBatch[]

  @@index([configId])
  @@index([configId, dayOfWeek, isActive])
  @@index([dayOfWeek, isActive])
}

model ProductionQuantityRule {
  id       Int @id @default(autoincrement())
  configId Int

  minQty            Decimal                @db.Decimal(12, 3)
  maxQty            Decimal?               @db.Decimal(12, 3)
  delayBusinessDays Int                    @default(0)
  targetWindow      ProductionTargetWindow @default(NEXT_AVAILABLE)
  isActive          Boolean                @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config ProductProductionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([configId, isActive, minQty, maxQty])
}

model ProductionBlackoutDate {
  id Int @id @default(autoincrement())

  branchId  Int?
  productId Int?

  date     DateTime
  reason   String?
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([productId])
  @@index([date])
  @@index([isActive])
}

model ProductionBatch {
  id        Int @id @default(autoincrement())
  branchId  Int
  productId Int
  windowId  Int

  productionDate DateTime
  windowStartAt  DateTime
  windowEndAt    DateTime
  readyAt        DateTime
  capacityQty    Decimal               @db.Decimal(12, 3)
  reservedQty    Decimal               @default(0) @db.Decimal(12, 3)
  status         ProductionBatchStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  window  ProductionCapacityWindow @relation(fields: [windowId], references: [id])
  items   ProductionBatchItem[]

  @@unique([branchId, productId, windowId, productionDate])
  @@index([branchId, productionDate])
  @@index([productId, productionDate])
  @@index([windowId])
  @@index([readyAt])
}

model ProductionBatchItem {
  id          Int @id @default(autoincrement())
  batchId     Int
  orderId     Int
  orderItemId Int

  quantityAssigned Decimal                   @db.Decimal(12, 3)
  status           ProductionBatchItemStatus @default(ACTIVE)
  source           ProductionScheduleSource  @default(AUTO)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  batch     ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([orderId])
  @@index([status])
}

model OrderFile {
  id Int @id @default(autoincrement())

  orderId     Int
  orderItemId Int?

  type   OrderFileType   @default(ORIGINAL)
  status OrderFileStatus @default(ACTIVE)

  originalName String
  storedName   String

  relativePath String

  mimeType  String
  sizeBytes Int

  uploadedById Int?
  uploadedAt   DateTime @default(now())

  downloadedAt   DateTime?
  downloadedById Int?

  deleteAfter DateTime?
  deletedAt   DateTime?

  deleteAttempts  Int     @default(0)
  lastDeleteError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  uploadedBy   User? @relation("OrderFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  downloadedBy User? @relation("OrderFileDownloadedBy", fields: [downloadedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, status])
  @@index([orderItemId])
  @@index([status, deleteAfter])
  @@index([uploadedById])
  @@index([downloadedById])
}

model ProductProcessStep {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  order     Int
  isActive  Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, order])
  @@index([productId])
}

model OrderItemStep {
  id          Int        @id @default(autoincrement())
  orderItemId Int
  name        String
  order       Int
  status      StepStatus @default(PENDING)
  doneAt      DateTime?

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, order])
  @@index([orderItemId, status])
}

model ProductOptionGroup {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  required  Boolean @default(false)
  minPick   Int     @default(0)
  maxPick   Int?
  order     Int     @default(0)
  isActive  Boolean @default(true)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])
}

model ProductOption {
  id         Int     @id @default(autoincrement())
  groupId    Int
  name       String
  priceDelta Decimal @default(0) @db.Decimal(12, 2)
  order      Int     @default(0)
  isActive   Boolean @default(true)

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model OrderItemOption {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  optionId    Int
  name        String
  priceDelta  Decimal @db.Decimal(12, 2)

  quantity   Decimal         @default(1) @db.Decimal(12, 3)
  chargeType ParamChargeType @default(PER_METER)
  subtotal   Decimal         @default(0) @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([optionId])
}
